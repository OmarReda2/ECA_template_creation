  <bpmn:collaboration id="Collaboration_0kjum9g">
    <bpmn:participant id="Participant_1n8r7eg" name="exportVersion endpoint" processRef="Process_0s6w7jv" />
    <bpmn:textAnnotation id="TextAnnotation_0zhkpl5">
      <bpmn:text>endpoint: /{versionId}/export
parameters: 
            @PathVariable UUID versionId, 
            @RequestBody ExportRequest request,
            HttpServletResponse response</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vramhn">
      <bpmn:text>public record ExportRequest(
        String format,
        String fileName,
        Boolean includeInstructionsSheet,
        Boolean includeValidationRules,
        Boolean protectSheets
)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_08pxtbq" associationDirection="None" sourceRef="TextAnnotation_0zhkpl5" targetRef="Participant_1n8r7eg" />
    <bpmn:textAnnotation id="TextAnnotation_0du5khm">
      <bpmn:text>1. check if the request not null

2. request.formal = ".XLSX"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0elt4xw">
      <bpmn:text>- generate file name base on versionId if not specified

- if specified keep it and sanitize it (clean it from unsupported char)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0lzaj3f">
      <bpmn:text>It prepares the filename to be safely used in HTTP headers (especially for downloads), ensuring spaces and special characters work correctly across browsers.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16gtvg4">
      <bpmn:text>add encoded fileName in proper http response headers

like
-response.Content-Type
= xlsx standard,
(like app/json for json)

- response.Content-Disposition = downloadable + readable file (encoded fileName)</bpmn:text>
    </bpmn:textAnnotation>
